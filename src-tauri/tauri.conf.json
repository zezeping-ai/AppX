{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppX",
  "version": "0.3.0",
  "identifier": "com.zezeping.appx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AppX",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "sql": {
      "busy_timeout": 2000,
      "logLevel": "off"
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRkMzNzc0QjZCN0U4RDcKUldUWDZMZTJkRGY4WEU0NXF5REdKVEpBSXMzanNnSS9Nc3M4bHlsNDZOZVQ0QXh5UTVzcmNEMkoK",
      "endpoints": [
        "https://github.com/zezeping-ai/AppX/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Resources/doc-axdoc.icns": "icons/doc-axdoc.icns",
        "Resources/doc-encrypted.icns": "icons/doc-encrypted.icns"
      }
    },
    "fileAssociations": [
      {
        "ext": ["axdoc"],
        "name": "AppX Document",
        "description": "AppX rich text document",
        "mimeType": "application/x-appx-axdoc",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zezeping.appx.axdoc",
          "conformsTo": ["public.data", "public.content"]
        }
      },
      {
        "ext": ["x"],
        "name": "AppX Encrypted File",
        "description": "AppX encrypted document (.txt.x / .axdoc.x / …)",
        "mimeType": "application/x-appx-encrypted",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zezeping.appx.encrypted",
          "conformsTo": ["public.data", "public.content"]
        }
      },
      {
        "ext": ["x0"],
        "name": "AppX Custom Encrypted File",
        "description": "AppX custom-encrypted document (.txt.x0 / .axdoc.x0 / …)",
        "mimeType": "application/x-appx-encrypted-custom",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zezeping.appx.encrypted-custom",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
